# Supabase Configuration
# Получить на: https://supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://ваш-проект.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-анонимный-ключ

# Supabase Service Role Key (только для серверных операций!)
# ВНИМАНИЕ: Никогда не используй в клиентском коде!
SUPABASE_SERVICE_ROLE_KEY=ваш-service-role-ключ

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Yandex Metrika (опционально, для аналитики)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Google Analytics (опционально)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Email Configuration (для продакшена)
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@floqly.ru
SMTP_FROM_NAME=Floqly
